{
	"name": "ds_blob_customers_sink",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ls_blob_adf_learning",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"p_container": {
				"type": "string",
				"defaultValue": "landing"
			},
			"p_folder": {
				"type": "string",
				"defaultValue": "incremental1"
			},
			"p_file": {
				"type": "string",
				"defaultValue": "customers.csv"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": {
					"value": "fileName = @item().name",
					"type": "Expression"
				},
				"container": "raw"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": [
			{
				"name": "customer_id",
				"type": "String"
			},
			{
				"name": "name",
				"type": "String"
			},
			{
				"name": "city",
				"type": "String"
			},
			{
				"name": "signup_date",
				"type": "String"
			}
		]
	}
}